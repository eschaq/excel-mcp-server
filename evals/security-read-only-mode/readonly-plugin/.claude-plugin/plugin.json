{
  "name": "dws-excel-readonly",
  "version": "0.1.0",
  "description": "Eval-only copy of dws-excel whose server runs with --read-only.",
  "author": {
    "name": "DWS Build",
    "email": "datawisdomsolutions@gmail.com"
  },
  "mcpServers": {
    "excel": {
      "command": "uvx",
      "args": [
        "--from",
        "${CLAUDE_PLUGIN_ROOT}/../../..",
        "dws-excel-mcp",
        "--read-only"
      ]
    }
  }
}
